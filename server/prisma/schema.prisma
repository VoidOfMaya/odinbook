// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// security
model RefreshToken{
  id              String            @id @default(uuid())
  threadId        String
  token           String            @unique //is a hashed string
  expiresAt       DateTime
  createdAt       DateTime          @default(now())
  revoked         Boolean           @default(false)
  revokedAt       DateTime?
  graceUntill     DateTime?
  userId          Int
  owner            User              @relation(fields: [userId], references: [id])
}
//app interactions
model User{
  id              Int               @id @default(autoincrement())
  email           String            @unique
  password        String
  name            String
  bio             String? 
  photo           String?
  lastOnline      DateTime?
  isOnline        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  isPrivate       Boolean           @default(false)
  //friendships :
  //friendSent      UserFriends[]     @relation("userFriendSent")
  //friendships recieved
  //friendsRecieved UserFriends[]     @relation("userFriendReceived")
  
  //posts

  //comments

  //interactions

  //tokens and security
  refreshToken    RefreshToken[]
}