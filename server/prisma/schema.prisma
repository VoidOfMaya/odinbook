// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// security
model RefreshToken{
  id              String            @id @default(uuid())
  threadId        String
  token           String            @unique //is a hashed string
  expiresAt       DateTime
  createdAt       DateTime          @default(now())
  revoked         Boolean           @default(false)
  revokedAt       DateTime?
  graceUntill     DateTime?
  userId          Int
  owner            User              @relation(fields: [userId], references: [id])
}
//app interactions
model User{
  id              Int               @id @default(autoincrement())
  email           String            @unique
  password        String
  name            String
  bio             String? 
  photo           String?
  lastOnline      DateTime?
  isOnline        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  isPrivate       Boolean           @default(false)
  //friendships :
  friendSent      UserFriends[]     @relation("userFriendSent")
  //friendships recieved
  friendsRecieved UserFriends[]     @relation("userFriendReceived")
  
  //posts
  posts           Post[]
  //comments
  comments        Comment[]
  //interactions

  //tokens and security
  refreshToken    RefreshToken[]
}
enum status {
  PENDING
  ACTIVE
  BLOCKED
  DECLINED
}
//friendship
model UserFriends{
  id          Int               @id @default(autoincrement())
  status      status  @default(PENDING)
  createdAt   DateTime          @default(now())
  //relations
  userId      Int
  user        User              @relation("userFriendSent", fields: [userId], references: [id])
  
  friendId    Int
  friend      User              @relation("userFriendReceived",fields: [friendId],references: [id])
  
  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}
model Post{
  id          Int               @id @default(autoincrement())
  content     String            
  photoUrl    String?
  likes       Int               @default(0)
  createdAt   DateTime          @default(now())
  editedAt    DateTime?
  visibility  Boolean           @default(true)

  //author
  authorId    Int
  User        User              @relation(fields: [authorId],references: [id])

  //comments
  comments    Comment[]
}
model Comment{
  id          Int               @id @default(autoincrement())
  content     String            

  likes       Int               @default(0)
  createdAt   DateTime          @default(now())
  editedAt    DateTime?
  //author
  authorId    Int
  User        User              @relation(fields: [authorId],references: [id])
  //post pareent
  postId      Int
  post        Post              @relation(fields: [postId], references: [id])
  //reply comments
  parentId    Int?
  parent      Comment?          @relation("commentreplies",fields: [parentId], references: [id])
  replies     Comment[]         @relation("commentreplies")
}